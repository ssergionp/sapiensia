# Copie para .env e preencha. Nunca faça commit do .env.
DB_URL=jdbc:postgresql://localhost:5433/app
DB_USER=
DB_PASSWORD=
RESEND_API_KEY=
APP_PUBLIC_BASE_URL=
APP_ADMIN_EMAIL=
# Chave de cifragem do segredo do MFA: Base64 de 32 bytes. No local, o perfil local já tem uma chave fictícia.
APP_MFA_ENCRYPTION_KEY=
# Storage dos PDFs dos Produtos em produção (Supabase). A secret key é um segredo: só nos secrets da plataforma.
APP_STORAGE_SUPABASE_URL=
APP_STORAGE_SUPABASE_SECRET_KEY=
# Pix pelo Asaas: a chave da API é um segredo (só nos secrets da plataforma). O endereço do sandbox é https://api-sandbox.asaas.com; sem elas o perfil local usa o Asaas falso.
# A chave do Asaas começa com $aact_: no PowerShell use aspas simples ($env:APP_ASAAS_API_KEY = '...'); com aspas duplas o $aact_ é expandido e a chave fica vazia.
APP_ASAAS_API_KEY=
APP_ASAAS_API_BASE_URL=
